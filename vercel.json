{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 3008,
            "maxDuration": 60,
            "excludeFiles": "{tests/**,docs/**,.github/**,resources/js/**,resources/css/**,node_modules/**,playwright-report/**,test-results/**}"
        }
    },
    "redirects": [
        { "source": "/index.php", "destination": "/" }
    ],
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "Relaticle",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "DB_CONNECTION": "pgsql",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "warning",
        "SESSION_DRIVER": "database",
        "QUEUE_CONNECTION": "sync",
        "CACHE_STORE": "database",
        "BROADCAST_CONNECTION": "log",
        "MAIL_MAILER": "log",
        "REQUIRE_EMAIL_VERIFICATION": "false",
        "TRUSTED_PROXIES": "*"
    }
}
